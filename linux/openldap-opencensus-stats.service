[Unit]
Description=openldap-opencensus-stats
After=network.target
#  openldap-opencensus-stats.socket holds the stats log named pipe (FIFO)
#  open. If openldap-opencensus-stats.service can never start, nothing
#  reads the FIFO, and slapd blocks once slapd's writes fill the FIFO.
#  Because a full FIFO blocks slapd, the start limit below makes systemd
#  stop starting the service. systemd then marks the socket unit as failed
#  and closes the FIFO. slapd's writes then fail with the error code
#  `EPIPE`. slapd ignores the error, and the failure loses only the metrics.
StartLimitIntervalSec=60
StartLimitBurst=10
After=openldap-opencensus-stats.socket

[Service]
Type=simple
Restart=always
RestartSec=1
EnvironmentFile=-/etc/sysconfig/openldap-opencensus-stats
ExecStart=/usr/local/bin/openldap_opencensus_stats /etc/openldap-opencensus-stats.yml

[Install]
WantedBy=multi-user.target
